{
  "version": "1.0",
  "global": {
    "workspace_root": "/workspace",
    "log_level": "INFO",
    "max_workflow_retry": 2,
    "max_review_cycles": 6,
    "default_context_reset": false,
    "parallel_result_review": true,
    "parallel_result_review_limit": 3,
    "env_vars": {}
  },
  "agents": [
    {
      "id": "mock-worker",
      "name": "Mock Worker",
      "type": "claude_code",
      "reset_context": false,
      "runtime_config": {
        "model": "claude-sonnet-4-20250514",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 8000,
        "timeout_seconds": 3600
      }
    },
    {
      "id": "mock-advisor",
      "name": "Mock Advisor",
      "type": "claude_code",
      "reset_context": true,
      "runtime_config": {
        "model": "claude-sonnet-4-20250514",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 4000,
        "timeout_seconds": 3600
      }
    }
  ],
  "plugins": [
    {
      "id": "env_setup",
      "name": "环境变量设置",
      "module_path": "app.pi_vuln_core.plugins.builtin.env_setup",
      "class_name": "EnvSetupPlugin",
      "config": {
        "extra_vars": {}
      }
    },
    {
      "id": "workspace_init",
      "name": "工作目录初始化",
      "module_path": "app.pi_vuln_core.plugins.builtin.workspace_init",
      "class_name": "WorkspaceInitPlugin",
      "config": {
        "create_subdirs": [
          "input",
          "working",
          "results",
          "reviews",
          "output"
        ]
      }
    },
    {
      "id": "task_validator",
      "name": "输入任务校验",
      "module_path": "app.pi_vuln_core.plugins.builtin.task_validator",
      "class_name": "TaskValidatorPlugin",
      "config": {}
    },
    {
      "id": "result_archiver",
      "name": "结果归档",
      "module_path": "app.pi_vuln_core.plugins.builtin.result_archiver",
      "class_name": "ResultArchiverPlugin",
      "config": {
        "archive_format": "tar.gz"
      }
    },
    {
      "id": "next_task_generator",
      "name": "下阶段任务生成器",
      "module_path": "app.pi_vuln_core.plugins.builtin.next_task_generator",
      "class_name": "NextTaskGeneratorPlugin",
      "config": {
        "agent_id": null,
        "prompt_template": null,
        "output_subdir": "output"
      }
    }
  ],
  "workflows": {
    "atomic": [
      {
        "id": "test_vuln_scan",
        "name": "测试漏洞扫描",
        "type": "atomic",
        "description": "Mock 测试用原子工作流，扫描单个模块的漏洞",
        "working_dir_template": "vuln_scan_{task_id}",
        "start_plugins": [
          "env_setup",
          "workspace_init",
          "task_validator"
        ],
        "end_plugins": [
          "result_archiver",
          "next_task_generator"
        ],
        "engine": {
          "max_review_cycles": 6,
          "review_profile": "balanced",
          "max_worker_turns_per_cycle": 70,
          "reflection_passes_per_cycle": 1,
          "min_discovery_cycles_before_pass": 1,
          "reset_worker_session_per_cycle": true,
          "plateau_closure_streak": 2,
          "plateau_abort_streak": 3,
          "same_issue_stagnation_threshold": 2,
          "same_issue_abort_threshold": 3,
          "per_issue_attempt_budget": 2,
          "analysis_closure_cycles": 1,
          "issue_churn_closure_window": 2,
          "issue_churn_abort_window": 3,
          "score_min_delta": 0.03
        },
        "roles": {
          "worker": {
            "agent_id": "mock-worker",
            "new_session": true,
            "reset_context_override": null,
            "prompts": {
              "work": {
                "system_prompt_file": "prompts/vuln_scan/worker_system.md",
                "user_prompt_file": "prompts/vuln_scan/worker_user.md"
              },
              "reflection": [
                {
                  "id": "reflect_completeness",
                  "prompt_file": "prompts/vuln_scan/reflect_completeness.md",
                  "description": "检查是否遗漏了常见漏洞类型"
                }
              ],
              "summary": {
                "prompt_file": "prompts/vuln_scan/summary.md",
                "output_summary_filename": "summary.md",
                "output_results_dir": "results"
              }
            }
          },
          "advisors": {
            "global_review": [
              {
                "instance_id": "global_completeness",
                "agent_id": "mock-advisor",
                "role_name": "全面性审计",
                "re_review_on_cycle": true,
                "system_prompt_file": "prompts/vuln_scan/global_review_completeness_sys.md",
                "user_prompt_template": "prompts/vuln_scan/global_review_completeness_user.md",
                "score_fields": [
                  "input_coverage",
                  "export_followthrough",
                  "used_coverage",
                  "limitations_honesty",
                  "report_completeness"
                ],
                "score_thresholds_start": {
                  "input_coverage": 0.8,
                  "export_followthrough": 0.7,
                  "used_coverage": 0.7,
                  "limitations_honesty": 0.75,
                  "report_completeness": 0.7
                },
                "score_thresholds": {
                  "input_coverage": 1.0,
                  "export_followthrough": 0.95,
                  "used_coverage": 0.95,
                  "limitations_honesty": 0.95,
                  "report_completeness": 0.9
                },
                "score_threshold_ramp_cycles": 5
              },
              {
                "instance_id": "global_depth",
                "agent_id": "mock-advisor",
                "role_name": "深入性审计",
                "re_review_on_cycle": true,
                "system_prompt_file": "prompts/vuln_scan/global_review_depth_sys.md",
                "user_prompt_template": "prompts/vuln_scan/global_review_depth_user.md",
                "score_fields": [
                  "vuln_pattern_breadth",
                  "code_evidence_depth"
                ],
                "score_thresholds_start": {
                  "vuln_pattern_breadth": 0.6,
                  "code_evidence_depth": 0.6
                },
                "score_thresholds": {
                  "vuln_pattern_breadth": 0.85,
                  "code_evidence_depth": 0.85
                },
                "score_threshold_ramp_cycles": 5
              }
            ],
            "result_review": [
              {
                "instance_id": "result_fp_detector",
                "agent_id": "mock-advisor",
                "role_name": "误报检测员",
                "re_review_on_cycle": false,
                "system_prompt_file": "prompts/vuln_scan/result_review_sys.md",
                "user_prompt_template": "prompts/vuln_scan/result_review_user.md"
              }
            ]
          }
        }
      }
    ],
    "composite": [
      {
        "id": "test_pipeline",
        "name": "测试流水线",
        "type": "composite",
        "description": "包含单个原子工作流的最小组合工作流",
        "working_dir_template": "pipeline_{execution_id}",
        "stages": [
          {
            "stage_id": "stage_01_scan",
            "name": "漏洞扫描",
            "sequence": 1,
            "workflow_ref": "test_vuln_scan",
            "workflow_type": "atomic",
            "on_error": "skip_task",
            "description": "对输入模块执行漏洞扫描"
          }
        ]
      }
    ]
  },
  "execution": {
    "entry_workflow": "test_pipeline",
    "entry_workflow_type": "composite",
    "input_task": {
      "task_file": "input/task.md",
      "task_id": "test_001"
    },
    "output_dir": "output",
    "execution_id": "test_run_001",
    "runtime_mode": "local",
    "on_completion": {
      "exit_code_on_success": 0,
      "exit_code_on_failure": 1,
      "write_summary": true,
      "summary_file": "output/execution_summary.json"
    }
  }
}
