IPC_AUDIT_IMAGE=secflow-app-ipc-audit:latest
IPC_AUDIT_PORT=8080
IPC_AUDIT_EXECUTION_MODE=opencode_cli
IPC_AUDIT_MAX_PARALLEL_TASKS=1
IPC_AUDIT_DEFAULT_WORKSPACE_ID=oh61-main
IPC_AUDIT_STATE_HOST_PATH=./state
OH_WORKSPACE_HOST_PATH=/absolute/path/to/openharmony_6_1
IPC_AUDIT_POC_ENABLED=true
IPC_AUDIT_POC_RUNTIME_AVAILABLE=true
