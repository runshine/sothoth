# Local development only.
IPC_AUDIT_PORT=18080
IPC_AUDIT_EXECUTION_MODE=mock
IPC_AUDIT_MAX_PARALLEL_TASKS=1
IPC_AUDIT_DEFAULT_WORKSPACE_ID=oh61-main
IPC_AUDIT_STATE_HOST_PATH=./state
OH_WORKSPACE_HOST_PATH=/absolute/path/to/openharmony_6_1
OHEMU_ARCH=arm64
OHEMU_NETWORK_MODE=bridge
OHEMU_HDC_BASE_PORT=55555
OHEMU_WAIT_FOR_HDC_READY=1
OHEMU_HDC_READY_TIMEOUT=180
IPC_AUDIT_READY_CHECK_FILE_PATHS=/root/.codex/auth.json,/root/.codex/config.toml,/root/.config/opencode/opencode.json
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CODEX_AUTH_FILE=./provider-files/codex-auth.json.example
CODEX_CONFIG_TOML_FILE=./provider-files/config.toml.example
OPENCODE_CONFIG_FILE=./provider-files/opencode.json.example
IPC_AUDIT_POC_ENABLED=true
IPC_AUDIT_POC_RUNTIME_AVAILABLE=true
