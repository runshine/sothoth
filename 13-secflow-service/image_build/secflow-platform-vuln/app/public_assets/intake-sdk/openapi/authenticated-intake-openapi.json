{
  "openapi": "3.0.3",
  "info": {
    "title": "SecFlow Suspicion Authenticated Intake API",
    "version": "2.1.0",
    "description": "Only authenticated submissions are supported. Anonymous submission is not supported."
  },
  "paths": {
    "/api/vuln/public/intake/submissions": {
      "post": {
        "summary": "Authenticated suspicion submission",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuspicionSubmissionRequest"
              },
              "examples": {
                "simple_without_files": {
                  "summary": "Simple mode (without files)",
                  "value": {
                    "project_id": "44f9029d00650a10",
                    "report_id": "simple-demo-001",
                    "title": "Simple authenticated suspicion",
                    "summary": "Quick report without file artifacts",
                    "severity": "medium",
                    "cvss_score": 6.1,
                    "confidence": 68,
                    "state": "suspected",
                    "reporter": {
                      "name": "manual-intake",
                      "version": "1.0.0",
                      "type": "api"
                    },
                    "subject": {
                      "type": "http_endpoint",
                      "locator": "https://demo.example/api/login",
                      "name": "login api"
                    },
                    "evidence": {
                      "summary": "Suspicious status code and response pattern"
                    }
                  }
                },
                "normal_with_files": {
                  "summary": "Normal mode (with files and folder tree)",
                  "value": {
                    "project_id": "44f9029d00650a10",
                    "report_id": "normal-demo-001",
                    "title": "Normal authenticated suspicion with artifacts",
                    "summary": "Report with structured file artifacts",
                    "severity": "high",
                    "cvss_score": 8.0,
                    "confidence": 82,
                    "state": "suspected",
                    "reporter": {
                      "name": "pipeline-intake",
                      "version": "2.0.0",
                      "type": "cli"
                    },
                    "subject": {
                      "type": "service",
                      "locator": "10.10.10.10:443",
                      "name": "target service"
                    },
                    "evidence": {
                      "summary": "Captured error traces and suspicious payload"
                    },
                    "artifacts": [
                      {
                        "kind": "json",
                        "name": "finding.json",
                        "media_type": "application/json",
                        "encoding": "utf-8",
                        "content": "{\"finding_id\":\"normal-demo-001\"}"
                      },
                      {
                        "kind": "tree",
                        "name": "evidence",
                        "children": [
                          {
                            "kind": "file",
                            "name": "request.txt",
                            "path": "evidence/http/request.txt",
                            "content_ref": "artifact://evidence/http/request.txt"
                          },
                          {
                            "kind": "file",
                            "name": "response.txt",
                            "path": "evidence/http/response.txt",
                            "content_ref": "artifact://evidence/http/response.txt"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ReporterInfo": {
        "type": "object",
        "required": ["name", "version", "type"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["plugin", "service", "cli", "skill", "api", "human", "other"]
          },
          "vendor": { "type": "string" },
          "endpoint": { "type": "string" },
          "instance_id": { "type": "string" }
        }
      },
      "SubjectInfo": {
        "type": "object",
        "required": ["type", "locator"],
        "properties": {
          "type": { "type": "string" },
          "locator": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "EvidenceInfo": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "reproduction_hint": { "type": "string" },
          "references": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "ArtifactItem": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "artifact_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["file", "directory", "tree", "json", "text", "binary", "archive", "screenshot", "pcap", "request_response", "report", "script", "other"]
          },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string" },
          "size": { "type": "integer", "default": 0 },
          "encoding": { "type": "string", "enum": ["plain", "base64", "utf-8"] },
          "content": { "type": "string" },
          "content_ref": { "type": "string" },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArtifactItem" }
          },
          "metadata": { "type": "object" }
        }
      },
      "SuspicionSubmissionRequest": {
        "type": "object",
        "required": ["project_id", "title", "reporter", "subject"],
        "properties": {
          "project_id": { "type": "string" },
          "report_id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "default": "medium"
          },
          "cvss_score": {
            "type": "number",
            "format": "float",
            "default": 0
          },
          "confidence": { "type": "integer", "default": 0 },
          "state": {
            "type": "string",
            "enum": ["suspected", "confirmed", "rejected"],
            "default": "suspected"
          },
          "category": { "type": "string" },
          "rule_id": { "type": "string" },
          "rule_name": { "type": "string" },
          "fingerprint": { "type": "string" },
          "reported_at": { "type": "string", "format": "date-time" },
          "reporter": { "$ref": "#/components/schemas/ReporterInfo" },
          "subject": { "$ref": "#/components/schemas/SubjectInfo" },
          "evidence": { "$ref": "#/components/schemas/EvidenceInfo" },
          "artifacts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArtifactItem" }
          },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
