{
  "openapi": "3.0.3",
  "info": {
    "title": "SecFlow Suspicion Anonymous Intake API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/vuln/public/intake/submissions": {
      "post": {
        "summary": "Anonymous suspicion submission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuspicionSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReporterInfo": {
        "type": "object",
        "required": ["name", "version", "type"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["plugin", "service", "cli", "skill", "api", "human", "other"]
          },
          "vendor": { "type": "string" },
          "endpoint": { "type": "string" },
          "instance_id": { "type": "string" }
        }
      },
      "SubjectInfo": {
        "type": "object",
        "required": ["type", "locator"],
        "properties": {
          "type": { "type": "string" },
          "locator": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "EvidenceInfo": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "reproduction_hint": { "type": "string" },
          "references": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "ArtifactItem": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "artifact_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["file", "directory", "tree", "json", "text", "binary", "archive", "screenshot", "pcap", "request_response", "report", "script", "other"]
          },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string" },
          "size": { "type": "integer", "default": 0 },
          "encoding": { "type": "string", "enum": ["plain", "base64", "utf-8"] },
          "content": { "type": "string" },
          "content_ref": { "type": "string" },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArtifactItem" }
          },
          "metadata": { "type": "object" }
        }
      },
      "SuspicionSubmissionRequest": {
        "type": "object",
        "required": ["project_id", "title", "reporter", "subject"],
        "properties": {
          "project_id": { "type": "string" },
          "report_id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "default": "medium"
          },
          "cvss_score": {
            "type": "number",
            "format": "float",
            "default": 0
          },
          "confidence": { "type": "integer", "default": 0 },
          "state": {
            "type": "string",
            "enum": ["suspected", "confirmed", "rejected"],
            "default": "suspected"
          },
          "category": { "type": "string" },
          "rule_id": { "type": "string" },
          "rule_name": { "type": "string" },
          "fingerprint": { "type": "string" },
          "reported_at": { "type": "string", "format": "date-time" },
          "reporter": { "$ref": "#/components/schemas/ReporterInfo" },
          "subject": { "$ref": "#/components/schemas/SubjectInfo" },
          "evidence": { "$ref": "#/components/schemas/EvidenceInfo" },
          "artifacts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArtifactItem" }
          },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
