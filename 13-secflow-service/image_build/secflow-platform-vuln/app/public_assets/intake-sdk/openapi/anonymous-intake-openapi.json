{
  "openapi": "3.0.3",
  "info": {
    "title": "SecFlow Vulnerability Anonymous Intake API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/vuln/public/intake/submissions": {
      "post": {
        "summary": "Anonymous vulnerability submission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicIntakeSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicIntakeSubmissionRequest": {
        "type": "object",
        "required": ["project_id", "title"],
        "properties": {
          "project_id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "severity": { "type": "string", "default": "medium" },
          "confidence": { "type": "integer", "default": 0 },
          "reporter_type": {
            "type": "string",
            "enum": ["cli", "plugin", "skill", "api", "other"],
            "default": "other"
          },
          "reporter_name": { "type": "string" },
          "source_meta": { "type": "object" },
          "target_meta": { "type": "object" },
          "display_meta": { "type": "object" },
          "raw_payload": { "type": "object" },
          "attachments": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
