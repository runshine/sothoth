{
  "kind": "cli",
  "description": "认证 CLI 上报示例（仅支持认证，不支持匿名）",
  "flows": {
    "simple_without_files": {
      "command": "curl -X POST \"$SECFLOW_VULN_BASE/api/vuln/public/intake/submissions\" -H 'Authorization: Bearer $SECFLOW_TOKEN' -H 'Content-Type: application/json' --data @payload-simple.json",
      "payload_file": "payload-simple.json",
      "note": "用于快速上报，不携带 artifacts"
    },
    "normal_with_files": {
      "command": "curl -X POST \"$SECFLOW_VULN_BASE/api/vuln/public/intake/submissions\" -H 'Authorization: Bearer $SECFLOW_TOKEN' -H 'Content-Type: application/json' --data @payload-with-files.json",
      "payload_file": "payload-with-files.json",
      "note": "用于完整上报，携带 artifacts 文件/目录结构"
    }
  },
  "notes": [
    "必须携带 project_id",
    "必须携带 Authorization: Bearer <token>",
    "created_by_type 会自动写为 human",
    "如需文件夹结构，使用 artifacts[].children 递归表达"
  ]
}
