IMAGE_NAME=secflow-ai-agent-framework:latest
INSTALL_PI_CLI=1
PI_NPM_PACKAGE=@mariozechner/pi-coding-agent

HOST_RUNS_DIR=./runs
HOST_INPUT_DIR=./docker/input
# 如果你已经在宿主机登录过 pi CLI，请改成绝对路径，例如 /home/yourname/.pi
HOST_PI_HOME=./.docker-pi-home

DATA_FLOW_FILENAME=data_flow.md
SOURCE_DIRNAME=source
RUN_NAME=docker_scan
MODEL=claude-sonnet-4-20250514
PROVIDER=anthropic
THINKING=high
MAX_CYCLES=10
WORKER_TIMEOUT=1800
ADVISOR_TIMEOUT=1800
RESULT_REVIEW_CONCURRENCY=3

# 按你使用的 provider 填写；未使用可留空
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=
