apiVersion: v1
kind: ConfigMap
metadata:
  name: secflow-app-dataflow-vuln-scanner-config
  namespace: secflow-ns
data:
  config.yaml: |
    app:
      host: "0.0.0.0"
      port: 8080
      debug: false

    database:
      host: "mysql.sothothv2-ns.svc.cluster.local"
      port: 3306
      username: "secflow"
      password: "${SECFLOW_DATAFLOW_DB_PASSWORD}"
      name: "secflow"
      table_prefix: "secflow_dataflow_vuln_scanner_"
      pool_size: 40
      max_overflow: 20
      pool_timeout: 30

    auth_service:
      enabled: true
      host: "secflow-platform-auth"
      port: 80
      validate_human_token_path: "/api/auth/validate-human-token"
      validate_machine_token_path: "/api/auth/validate-token"
      service_machine_token: "${SECFLOW_DATAFLOW_SERVICE_MACHINE_TOKEN}"
      timeout: 10

    project_service:
      enabled: true
      host: "secflow-platform-project"
      port: 80
      get_project_path: "/api/project"
      health_path: "/api/project/health"
      timeout: 10

    fileserver_service:
      enabled: true
      base_url: "http://secflow-platform-fileserver/api/fileserver"
      timeout: 10
      data_mount_path: "/data"
      project_files_dirname: "files"
      dataflow_subproject_name: "DATAFLOW_VULN_SCANNER"

    configcenter_service:
      enabled: true
      base_url: "http://secflow-platform-configcenter/api/configcenter"
      timeout: 30

    vuln_engine_service:
      enabled: true
      base_url: "http://secflow-platform-vuln"
      submit_path: "/api/vuln/public/intake/submissions"
      timeout: 30

    runs:
      enabled: true

    registry:
      enabled: true
      menu_service_url: "http://secflow-platform-menu:80"
      service_id: "secflow-app-dataflow-vuln-scanner"
      service_name: "数据流漏洞挖掘服务"
      host: "secflow-app-dataflow-vuln-scanner"
      port: 80
      maturity: "开发中"
      description: "提供数据流漏洞挖掘任务下发、Profile配置、调度执行与状态查询能力"
      api_prefix: "/api/dataflow-vuln-scanner"
      unregister_on_shutdown: false
      heartbeat_interval_seconds: 30
      menu:
        id: "dataflow-vuln-scanner"
        path: "/dataflow-vuln-scanner"
        icon: "scan-search"
        order: 36
        level1_name: "执行"
        level2_name: "二进制安全测试"
        level3_name: "数据流漏洞挖掘"

    service:
      workspace_base_dir: "/data/files"
      default_execution_timeout_seconds: 0
      execution_cancel_check_interval_seconds: 1
      process_heartbeat_stale_after_seconds: 300
      agent_cleanup_enabled: true
      agent_cleanup_before_task_start: true
      agent_cleanup_after_task_finish: true
      agent_cleanup_force_kill_timeout_seconds: 5
      agent_cleanup_escalation_timeout_seconds: 2
      agent_cleanup_process_match_patterns:
        - "codex"
        - "opencode"
        - "claude"
        - "pi_agent"
        - "pi-agent"
        - ".pi/agent"
        - "PI_CODING_AGENT_DIR"
        - "run_vuln_scan.py"
      trigger_retry_limit: 0
      public_api_prefix: "/api/dataflow-vuln-scanner"
      admin_proxy_prefix: "/api/dataflow-vuln-scanner-admin-proxy"
      default_entry_task_type: "package_list"
      default_artifact_subdir: "assets"
      default_profile_template_kind: "vuln_scan_default"
      allow_absolute_input_refs: false

    scheduler:
      enabled: true
      manager_service_name: "secflow-app-dataflow-vuln-scanner-manager"
      manager_service_port: 80
      worker_capacity: 1
      poll_interval_seconds: 2
      heartbeat_interval_seconds: 5
      worker_timeout_seconds: 300
      cleanup_interval_seconds: 10

    dataflow_worker:
      api_key: null
      timeout: 30
      dispatch_retry_interval_seconds: 2
      dispatch_max_retries: 1

    logging:
      level: "INFO"
      format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
