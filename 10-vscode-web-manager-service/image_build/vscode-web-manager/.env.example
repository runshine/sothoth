# vscode-web-manager 环境变量配置
# 注意：主要配置请在 config.yaml 文件中配置，环境变量可覆盖YAML配置

# 基础配置（环境变量可覆盖YAML配置）
export DATABASE_URL="mysql+pymysql://username:password@localhost/source_manager"
export SECRET_KEY="your-secret-key"
export IN_K8S="true"  # 如果在K8S集群内部运行

# ============ 使用说明 ============
# 1. 主要配置在 /data/config.yaml 文件中配置
# 2. CodeWiki 配置在 config.yaml 的 codewiki 部分:
#    codewiki:
#      api_key: "your-claude-api-key"
#      base_url: "https://api.anthropic.com"
#      main_model: "claude-sonnet-4"
#      cluster_model: "claude-sonnet-4"
#      fallback_model: "glm-4p5"

python main.py